{%- comment -%}
  Paste this into the "Quadrant" tab of the pictures plugin's Edit Markup
  screen. Compact version for small Mashup panes: the bird with the clock
  centred under it, both at 1/3 size (every Game Boy block = exactly 1 px).
  The "updated" time is in the title bar (too little room under the clock).
{%- endcomment -%}

{%- assign utc_offset = trmnl.user.utc_offset | default: 3600 -%}
{%- assign hhmm = "now" | date: "%s" | plus: utc_offset | date: "%H%M" -%}
{%- assign updated_hm = updated_display | split: "kl " | last | split: " " | first -%}

<div class="layout layout--col layout--center" style="gap: 6px;">
  {%- comment -%} zoom 1/3: every Game Boy block -> exactly 1 px {%- endcomment -%}
  <img src="{{ image_url }}" style="zoom: 0.3333; image-rendering: pixelated;">

  <div style="display: flex; align-items: flex-end; justify-content: center; zoom: 0.3333;">
    <img src="{{ digits_url }}/{{ hhmm | slice: 0 }}.png" style="image-rendering: pixelated;">
    <img src="{{ digits_url }}/{{ hhmm | slice: 1 }}.png" style="image-rendering: pixelated;">
    <img src="{{ digits_url }}/colon.png" style="image-rendering: pixelated;">
    <img src="{{ digits_url }}/{{ hhmm | slice: 2 }}.png" style="image-rendering: pixelated;">
    <img src="{{ digits_url }}/{{ hhmm | slice: 3 }}.png" style="image-rendering: pixelated;">
  </div>
</div>

<div class="title_bar">
  <span class="title">{{ title | default: "Bilder" }}</span>
  <span class="instance">Uppdaterad {{ updated_hm }}</span>
</div>
