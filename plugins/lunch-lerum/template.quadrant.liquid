{%- comment -%}
  Paste this into the "Quadrant" tab of the lunch-lerum plugin's Edit
  Markup screen (separate from the "Full" tab's template.liquid). Compact
  version   for small Mashup panes - just today's lunch, no forecast table.

  Sizing note: value--large (58px) overflows a Quadrant pane (~1/4 screen);
  use value--small here instead, matching the fix applied to weather-yr.
{%- endcomment -%}

<div class="layout layout--col layout--center gap--xsmall">
  {% if today.lunch %}
  <div class="label">Dagens Lunch</div>
  <div class="value value--small" style="text-align: center;">{{ today.lunch | truncate: 40 }}</div>
  <img class="image" src="{{ today.lunch_icon_url }}" width="32" height="32" style="width: 32px; height: 32px;">
  {% elsif today.note %}
  <div class="label">{{ today.weekday }}</div>
  <div class="value">{{ today.note }}</div>
  {% else %}
  <div class="value">No lunch info</div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Skolmat</span>
</div>
