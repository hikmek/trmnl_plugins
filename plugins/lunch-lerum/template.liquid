{%- comment -%}
  Paste this into the TRMNL Private Plugin "Markup" editor for the
  lunch-lerum plugin (Polling strategy). Field names match the JSON
  produced by fetch.mjs (see data.json / README.md in this folder).

  View-only markup: no <div class="screen">/"view"> wrappers needed -
  TRMNL's platform supplies those for private plugins.

  Three-column layout, left to right:
  1. Skolmatn - the school's VEGETARIAN option only (today.vegetarian) on
     weekdays; on Lördag/Söndag (today.is_weekend) there's never a school
     menu at all, so this column shows "HELGn = Ingen skolmatn" instead.
  2. Hemmamatn - the family's home-cooked weekend menu (from the shared
     Google Sheet), showing BOTH Lördag and Söndag (Lunch + Middag each)
     for the current ISO week - shown every day, not just on the weekend
     itself, since a weekday's current ISO week already covers its
     upcoming weekend.
  3. Dagens kockn - today's random pick from the broforce portrait roster
     (unrelated in content to the other two columns - see fetch.mjs's
     pickDagensKock()): "Dagens kock:" label, picture, name, and a Swedish
     description underneath (fetch.mjs translates broforce's English
     description via DAGENS_KOCK_DESCRIPTIONS_SV - lunch-lerum-only, does
     not touch broforce's own English Full view).
{%- endcomment -%}

<div class="layout layout--col gap--large">

  <div class="layout layout--row gap--large">

    <div class="item layout layout--col layout--center gap--xsmall" style="flex: 1;">
      <div class="label">Skolmatn</div>
      {% if today.is_weekend %}
      <div class="value" style="text-align: center;">{{ today.note }}</div>
      {% elsif today.vegetarian %}
      <div class="value value--large" style="text-align: center;">{{ today.vegetarian }}</div>
      <img class="image" src="{{ today.vegetarian_icon_url }}" width="48" height="48" style="width: 48px; height: 48px;">
      {% elsif today.note %}
      <div class="value" style="text-align: center;">{{ today.note }}</div>
      {% else %}
      <div class="value">Ingen vegetarisk rätt idag</div>
      {% endif %}
    </div>

    <div class="item layout layout--col layout--center gap--xsmall" style="flex: 1;">
      <div class="label">Hemmamatn{% if today.hemmamat %} · v{{ today.hemmamat.vecka }}{% endif %}</div>
      {% if today.hemmamat %}
      <div class="value" style="text-align: center;">
        <strong>Lör:</strong> {{ today.hemmamat.lordag.lunch | default: "-" }} / {{ today.hemmamat.lordag.middag | default: "-" }}
      </div>
      <div class="value" style="text-align: center;">
        <strong>Sön:</strong> {{ today.hemmamat.sondag.lunch | default: "-" }} / {{ today.hemmamat.sondag.middag | default: "-" }}
      </div>
      {% else %}
      <div class="value">Ingen hemmamat inlagd än</div>
      {% endif %}
    </div>

    <div class="item layout layout--col layout--center gap--xsmall" style="flex: 1;">
      <div class="label">Dagens kock:</div>
      {% if today.dagens_kock %}
      <img class="image image--contain image-dither" src="{{ today.dagens_kock.image_url }}" style="max-height: 45%;">
      <div class="value value--small" style="text-align: center;">{{ today.dagens_kock.name }}</div>
      <div class="description" style="text-align: center;">{{ today.dagens_kock.description }}</div>
      {% else %}
      <div class="value">-</div>
      {% endif %}
    </div>

  </div>

  <div class="divider"></div>

  <table class="table">
    <thead>
      <tr>
        <th>Day</th>
        <th>Lunch</th>
        <th>Vegetarian</th>
      </tr>
    </thead>
    <tbody>
      {% for day in upcoming %}
      <tr>
        <td>{{ day.weekday }}{% if day.note %} ({{ day.note }}){% endif %}</td>
        <td>
          {% if day.lunch %}
          <div class="layout layout--col layout--center gap--xsmall">
            <span style="text-align: center;">{{ day.lunch }}</span>
            <img class="image" src="{{ day.lunch_icon_url }}" width="22" height="22" style="width: 22px; height: 22px;">
          </div>
          {% else %}
          <span>-</span>
          {% endif %}
        </td>
        <td>
          {% if day.vegetarian %}
          <div class="layout layout--col layout--center gap--xsmall">
            <span style="text-align: center;">{{ day.vegetarian }}</span>
            <img class="image" src="{{ day.vegetarian_icon_url }}" width="22" height="22" style="width: 22px; height: 22px;">
          </div>
          {% else %}
          <span>-</span>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

</div>

<div class="title_bar">
  <span class="title">Matn</span>
  <span class="instance">{{ updated_display }}</span>
</div>
