{%- comment -%}
  Paste this into the TRMNL Private Plugin "Markup" editor for the
  bus-grabo plugin (Polling strategy). Field names match the JSON
  produced by fetch.mjs (see data.json / README.md in this folder).

  Every line uses the same "label" component on purpose: TRMNL maps
  "label" to a single pixel font (NicoClean / TRMNL16, per the active
  bundle) at one fixed size on real e-ink devices, so using it for every
  line - headers and departures alike - guarantees identical, pixelated
  text throughout instead of mixing value/table fonts of different sizes.

  View-only markup: no <div class="screen">/"view"> wrappers needed -
  TRMNL's platform supplies those for private plugins.
{%- endcomment -%}

<div class="layout layout--col gap--medium">

  <div class="label">MJÖRN AVGÅNG</div>
  {% for dep in mjorn.departures %}
  <div class="label">{{ dep.line }} {{ dep.destination }}{% if dep.is_cancelled %} (INSTÄLLD){% endif %} - {{ dep.estimated_time }}{% if dep.delay_minutes > 0 %} (+{{ dep.delay_minutes }}){% endif %} - {{ dep.minutes_until }} min</div>
  {% endfor %}

  <div class="divider"></div>

  <div class="label">-&gt; GÖTEBORG (Gråbo busstation)</div>
  {% for dep in mjornbotorget_to_goteborg.departures %}
  <div class="label">{{ dep.line }} {{ dep.destination }}{% if dep.is_cancelled %} (INSTÄLLD){% endif %} - {{ dep.estimated_time }}{% if dep.delay_minutes > 0 %} (+{{ dep.delay_minutes }}){% endif %} - {{ dep.minutes_until }} min</div>
  {% endfor %}

</div>

<div class="title_bar">
  <span class="title">Bussar · Gråbo</span>
  <span class="instance">Västtrafik</span>
</div>
