{%- comment -%}
  Paste this into the "Quadrant" tab of the broforce plugin's Edit Markup
  screen. Compact version for small Mashup panes - portrait + name only, no
  description (too little room).
{%- endcomment -%}

<div class="layout layout--col layout--center gap--small">
  <img class="image image--contain image-dither" src="{{ bro.image_url }}" style="max-height: 75%;">
  <div class="label">{{ bro.name }}</div>
</div>

<div class="title_bar">
  <span class="title">BROFORCE</span>
</div>
